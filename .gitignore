# Vortex-Ai-Chat build and data locations
/target
**/target
Cargo.lock.orig
# UI build output (Trunk). Deliberately fully untracked: Trunk empties this
# directory on every build, so even a .gitkeep cannot be tracked here.
# build.rs creates the folder + a placeholder index.html on fresh clones.
crates/vortex-server/ui-dist/

# Local environment / secrets
.env
*.local.toml

# Local tool state (agent plans, worktrees)
.kilo/

# Runtime data (never commit databases, caches, workspaces)
*.db
*.db-shm
*.db-wal
.vortex-data/
