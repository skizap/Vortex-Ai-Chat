# Vortex-Ai-Chat — optional local environment file.
# Copy to `.env` and fill in the values you want. NEVER commit your real `.env`.
# The server also reads OPENROUTER_API_KEY from the process environment.

# Required for real model access via OpenRouter (https://openrouter.ai/keys).
# Create an account, generate a key, and paste it here. Keep this file private (chmod 600).
OPENROUTER_API_KEY=

# Optional: override the OpenRouter-compatible endpoint (default: https://openrouter.ai/api/v1).
# VORTEX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: config/data/cache directory overrides (XDG defaults are documented in README.md).
# VORTEX_CONFIG_DIR=
# VORTEX_DATA_DIR=
# VORTEX_CACHE_DIR=

# Optional: server bind address/port (defaults to 127.0.0.1:8417; LAN exposure is
# deliberately configured in config.toml instead — see docs/SECURITY.md).
# VORTEX_HOST=127.0.0.1
# VORTEX_PORT=8417

# Testing-only: use the built-in mock LLM provider (no network, no credentials).
# VORTEX_LLM=mock
# VORTEX_MOCK_SCRIPT=echo        # echo | tools

# Testing-only: SearXNG instance URL for research tools (see README.md "Search setup").
# VORTEX_SEARXNG_URL=http://127.0.0.1:8888
